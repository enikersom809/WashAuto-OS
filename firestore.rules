rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Tenants (Empresas de Lava-Jato) - Multi-tenant PWA e Computador
    match /tenants/{tenantId} {
      allow read, write: if true;

      // Subcoleção: Agendamentos da Empresa (Celular <-> Computador)
      match /appointments/{appointmentId} {
        allow read, write: if true;
      }

      // Subcoleção: Itens de Lavagem / Fila do Pátio em tempo real
      match /washItems/{washItemId} {
        allow read, write: if true;
      }

      // Subcoleção: Histórico de Lavagens Concluídas
      match /washHistory/{historyId} {
        allow read, write: if true;
      }

      // Subcoleção: Clientes da Empresa
      match /clients/{clientId} {
        allow read, write: if true;
      }

      // Subcoleção: Resgates de Fidelidade
      match /redemptions/{redemptionId} {
        allow read, write: if true;
      }

      // Subcoleção: Pontos de Fidelidade
      match /fidelityPoints/{clientKey} {
        allow read, write: if true;
      }

      // Subcoleção: Equipe / Funcionários
      match /staff/{staffId} {
        allow read, write: if true;
      }

      // Subcoleção: Produtos & Estoque
      match /products/{productId} {
        allow read, write: if true;
      }

      // Subcoleção: Configurações da Empresa
      match /config/{configId} {
        allow read, write: if true;
      }
    }

    // 2. Raiz: Agendamentos Gerais
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // 3. Raiz: Clientes Gerais (Ficha Cadastral e Veículos)
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // 3.1 Raiz: Clientes em tempo real
    match /clientes/{clienteId} {
      allow read, write: if true;
    }

    // 4. Raiz: Empresas (Busca pelo PWA e QR Code)
    match /empresas/{empresaId} {
      allow read, write: if true;
    }

    // 5. Raiz: Usuários e Autenticação (Sessão sincronizada Nuvem PC e Celular)
    match /usuarios/{usuarioId} {
      allow read, write: if true;
    }

    // 6. Fallback de teste de conexão
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}

