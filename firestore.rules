rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions para validação de IDs
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    // 1. Tenants (Empresas de Lava-Jato)
    match /tenants/{tenantId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(tenantId);

      // Subcoleção: Agendamentos da Empresa
      match /appointments/{appointmentId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(tenantId) && isValidId(appointmentId);
      }

      // Subcoleção: Itens de Lavagem / Fila do Pátio
      match /washItems/{washItemId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(tenantId) && isValidId(washItemId);
      }

      // Subcoleção: Clientes da Empresa
      match /clients/{clientId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(tenantId) && isValidId(clientId);
      }

      // Subcoleção: Resgates de Fidelidade
      match /redemptions/{redemptionId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(tenantId) && isValidId(redemptionId);
      }

      // Subcoleção: Configurações da Empresa
      match /config/{configId} {
        allow get, list, create, update, delete: if isValidId(tenantId);
      }
    }

    // 2. Raiz: Agendamentos Gerais
    match /appointments/{appointmentId} {
      allow get, list, create, update, delete: if isValidId(appointmentId);
    }

    // 3. Raiz: Clientes Gerais (Ficha Cadastral e Veículos)
    match /clients/{clientId} {
      allow get, list, create, update, delete: if isValidId(clientId);
    }

    // 3.1 Raiz: Clientes em tempo real (Coleção 'clientes' compatível com formulário e mobile)
    match /clientes/{clienteId} {
      allow read, write: if true;
    }

    // 4. Raiz: Empresas (Busca pelo PWA e QR Code)
    match /empresas/{empresaId} {
      allow get, list, create, update, delete: if isValidId(empresaId);
    }

    // 5. Fallback de teste de conexão
    match /test/{testId} {
      allow read, write: if isValidId(testId);
    }
  }
}
