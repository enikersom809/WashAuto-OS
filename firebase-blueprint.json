{
  "entities": {
    "tenants": {
      "title": "Tenants",
      "description": "Lava-jato Companies registered in the system",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "plan": { "type": "string" },
        "status": { "type": "string" },
        "domain": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "mrr": { "type": "number" },
        "levaETrazConfig": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "plan", "status"]
    },
    "appointments": {
      "title": "Appointments",
      "description": "Scheduled appointments created by clients or companies",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "clientEmail": { "type": "string" },
        "vehicle": { "type": "string" },
        "plate": { "type": "string" },
        "service": { "type": "string" },
        "price": { "type": "number" },
        "dateTime": { "type": "string" },
        "addressSummary": { "type": "string" },
        "status": { "type": "string" },
        "assignedWasher": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "reminder24hEnabled": { "type": "boolean" },
        "reminder24hScheduledAt": { "type": "string" },
        "reminder24hSent": { "type": "boolean" },
        "reminder24hSentAt": { "type": "string" },
        "reminderChannel": { "type": "string" },
        "reminderNotes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["tenantId", "clientName", "vehicle", "plate", "service", "dateTime"]
    },
    "washItems": {
      "title": "Wash Items",
      "description": "Vehicle washes queue and yard history",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "plate": { "type": "string" },
        "vehicle": { "type": "string" },
        "service": { "type": "string" },
        "price": { "type": "number" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "status": { "type": "string" },
        "washer": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["tenantId", "plate", "vehicle", "status"]
    },
    "clientProfiles": {
      "title": "Client Profiles",
      "description": "Client personal data, address and vehicle list",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "neighborhood": { "type": "string" },
        "city": { "type": "string" },
        "stateUf": { "type": "string" },
        "cep": { "type": "string" },
        "fidelityPoints": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["tenantId", "name", "phone"]
    },
    "redemptions": {
      "title": "Redemptions",
      "description": "Reward redemption requests from clients",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "vehicle": { "type": "string" },
        "requested": { "type": "boolean" },
        "status": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["tenantId", "clientName", "requested"]
    },
    "cashTransactions": {
      "title": "Cash Transactions",
      "description": "Cash flow transactions (income, expense, sales, withdrawals)",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "type": { "type": "string", "enum": ["entrada", "saida"] },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "operator": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["tenantId", "type", "description", "amount", "paymentMethod", "date"]
    },
    "oilChanges": {
      "title": "Oil Changes",
      "description": "Vehicle oil change history and next scheduled changes",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "vehiclePlate": { "type": "string" },
        "vehicleModel": { "type": "string" },
        "currentKm": { "type": "number" },
        "intervalKm": { "type": "number" },
        "nextChangeKm": { "type": "number" },
        "totalPrice": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["tenantId", "vehiclePlate", "currentKm", "nextChangeKm", "totalPrice"]
    },
    "levaETraz": {
      "title": "Leva e Traz",
      "description": "Valet pick-up and delivery requests with live vehicle tracking",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "clientEmail": { "type": "string" },
        "vehicle": { "type": "string" },
        "plate": { "type": "string" },
        "service": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "feePrice": { "type": "number" },
        "totalPrice": { "type": "number" },
        "driverName": { "type": "string" },
        "appointmentId": { "type": "string" },
        "washItemId": { "type": "string" },
        "scheduledDate": { "type": "string" },
        "scheduledTime": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["tenantId", "clientName", "vehicle", "plate", "status"]
    },
    "clientFcmTokens": {
      "title": "Client FCM Tokens",
      "description": "FCM tokens and Web Push subscriptions registered by clients for vehicle status alerts",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "phoneDigits": { "type": "string" },
        "clientEmail": { "type": "string" },
        "plates": { "type": "array", "items": { "type": "string" } },
        "fcmToken": { "type": "string" },
        "endpoint": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["tenantId", "active"]
    },
    "clientNotifications": {
      "title": "Client Status Notifications",
      "description": "Real-time vehicle status change push notifications dispatched to clients",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "phoneDigits": { "type": "string" },
        "clientEmail": { "type": "string" },
        "vehicle": { "type": "string" },
        "plate": { "type": "string" },
        "newStatus": { "type": "string" },
        "source": { "type": "string" },
        "url": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["tenantId", "title", "body", "newStatus", "createdAt"]
    }
  },
  "firestore": {
    "/tenants/{tenantId}": {
      "schema": "tenants",
      "description": "Tenant company profile and configuration"
    },
    "/tenants/{tenantId}/cash_transactions/{transactionId}": {
      "schema": "cashTransactions",
      "description": "Tenant cash flow transactions"
    },
    "/tenants/{tenantId}/oil_changes/{oilChangeId}": {
      "schema": "oilChanges",
      "description": "Tenant vehicle oil change records"
    },
    "/tenants/{tenantId}/appointments/{appointmentId}": {
      "schema": "appointments",
      "description": "Client scheduled wash appointments"
    },
    "/tenants/{tenantId}/washItems/{washItemId}": {
      "schema": "washItems",
      "description": "Yard wash jobs in progress and history"
    },
    "/tenants/{tenantId}/clients/{clientId}": {
      "schema": "clientProfiles",
      "description": "Registered clients of a specific tenant"
    },
    "/tenants/{tenantId}/redemptions/{redemptionId}": {
      "schema": "redemptions",
      "description": "Loyalty stamp redemption requests"
    },
    "/appointments/{appointmentId}": {
      "schema": "appointments",
      "description": "Root collection for appointments indexing"
    },
    "/clients/{clientId}": {
      "schema": "clientProfiles",
      "description": "Global client profile registry"
    },
    "/clientes/{clienteId}": {
      "schema": "clientProfiles",
      "description": "Real-time client records linked by empresa"
    },
    "/empresas/{empresaId}": {
      "schema": "tenants",
      "description": "Public company profile for PWA and QR Code lookup"
    },
    "/tenants/{tenantId}/leva_e_traz/{levaETrazId}": {
      "schema": "levaETraz",
      "description": "Valet pick-up and delivery requests for tenant"
    },
    "/tenants/{tenantId}/client_fcm_tokens/{tokenId}": {
      "schema": "clientFcmTokens",
      "description": "FCM tokens and Web Push subscriptions for client devices"
    },
    "/tenants/{tenantId}/client_notifications/{notificationId}": {
      "schema": "clientNotifications",
      "description": "Client vehicle status update notifications"
    }
  }
}
