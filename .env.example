# ==========================================
# Variáveis de Ambiente (Netlify & Local)
# ==========================================

# GEMINI_API_KEY: Necessária para as análises com IA no Netlify Functions (/api/ai-insights)
# No Netlify: Configure em "Site configuration" -> "Environment variables"
GEMINI_API_KEY="AIzaSy..."

# APP_URL: URL do aplicativo (ex: https://seu-app.netlify.app)
APP_URL="https://seu-app.netlify.app"

# ==========================================
# Configurações do Firebase (Opcionais no Netlify)
# Se não preenchidas, o sistema usa as configurações de firebase-applet-config.json
# ==========================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID="meulavajatogestaoparalavajato"
VITE_FIREBASE_AUTH_DOMAIN="meulavajatogestaoparalavajato.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="meulavajatogestaoparalavajato.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="372328060896"
VITE_FIREBASE_APP_ID="1:372328060896:web:596b7467604aba2a78bd85"
VITE_FIREBASE_DATABASE_ID="(default)"
